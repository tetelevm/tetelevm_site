{$DOMAIN:?DOMAIN environment variable is required} {
	encode zstd gzip

	handle /_api/* {
		reverse_proxy backend:8000
	}

	handle /_admin/* {
		reverse_proxy backend:8000
	}

	handle_path /_static/* {
		root * /static
		file_server
	}

	handle_path /files/* {
		root * /media
		file_server
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
