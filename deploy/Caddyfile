{$DOMAIN:?DOMAIN environment variable is required} {
	encode zstd gzip

	handle /robots.txt {
		reverse_proxy backend:8000
	}

	handle /sitemap.xml {
		reverse_proxy backend:8000
	}

	handle /_api/* {
		reverse_proxy backend:8000
	}

	handle /_admin/* {
		reverse_proxy backend:8000
	}

	handle_path /_static/* {
		root * /static
		file_server
	}

	handle_path /files/* {
		root * /media
		file_server
	}

	handle {
		root * /srv
		try_files {path} /index.html
		templates
		file_server
	}

	handle_errors 404 {
		root * /srv
		header X-Robots-Tag "noindex"
		rewrite * /index.html
		templates
		file_server
	}
}
